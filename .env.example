# Deployed Google Apps Script web app URL that appends registration JSON to your sheet.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Use strong values in your local .env file.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@innovation.center
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PORT=3000
